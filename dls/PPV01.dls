 #define MSG_ENABLE  <-> _MSG(type=etat,libelle="Panneaux Photovoltaïques branchés au réseau EDF.");
 #define MSG_DISABLE <-> _MSG(type=etat,libelle="Panneaux Photovoltaïques NON branchés au réseau EDF.");

 #define TICK_WH     <-> _DI; /* 1 Wh par Impulsion */
 #define CI_WH       <-> _CI(libelle="Nombre de Wh récupéré");

 #define B_USER_BLACKOUT          <-> _B(libelle="Demande de désactivation de la production solaire par le user");
 #define M_TIME_BLACKOUT          <-> _M(libelle="Blackout production solaire sur créneau horaire");
 #define DO_ARRET_PRODUCTION      <-> _DO(libelle="Commande du contacteur NF de coupure solaire");
 #define VISUEL_ARRET_PRODUCTION  <-> _I(forme="switch",mode="off",libelle="Production solaire");

 #define PRODUCTION               <-> _R(libelle="Production d'energie", unite="W");
 #define VISUEL_PRODUCTION        <-> _I(forme="cadran", mode="progress-rov", decimal=0, min=0,max=1400,seuil_ntb=50,seuil_nb=100, input=PRODUCTION);

 #define INTENSITE                <-> _AI(libelle="Intensité instantanée des panneaux PPV01");
 #define VISUEL_INTENSITE         <-> _I(forme="cadran", mode="progress-rov",decimal=2,min=0,max=6,seuil_ntb=0.2,seuil_nb=0.5, input=INTENSITE); /* Intensité instantanée des panneaux PPV01 */
 #define MSG_INTENSITE_NOTINRANGE <-> _MSG(type=defaut,libelle="Intensité instantanée Not In Range !");

                                    /*******************************************/
 /***********************************        SYNTHESES DEFAUTS ET ALARMES       ***********************************/
                                    /*******************************************/
/* SYNTHESES DEFAUTS ---------------------------------------------------------*/
 /* DEFAUTS */
  -_FALSE                                 -> MEMSA_DEFAUT;

 /* DEFAUTS FIXES */
  -_FALSE                                 -> MEMSA_DEFAUT_FIXE;

                                  /********************************************/
/**********************************         COMPTE RENDUS DES VIGNETTES        ***********************************/
                                  /********************************************/
/* ACTIVITES -----------------------------------------------------------------*/
/* SECURITE DES BIENS -----------------------------------------------------*/
 - _TRUE -> MEMSSB_VEILLE;

                                     /*******************************************/
 /***********************************              FONCTIONS PILOTEES           ***********************************/
                                    /*******************************************/

/* Gestion du blackout par le user */
 - VISUEL_ARRET_PRODUCTION_CLIC ->
    { switch
       | -/B_USER_BLACKOUT -> B_USER_BLACKOUT;
       | -                 ->/B_USER_BLACKOUT;
    }

/* Gestion du blackout par le temps */
 - _HEURE >= 22:00 + _HEURE <= 05:00 -> M_TIME_BLACKOUT;
 
/* Calcul de l'état attendu du contacteur */
 switch
  | - B_USER_BLACKOUT + M_TIME_BLACKOUT -> DO_ARRET_PRODUCTION;
  | -                                   ->/DO_ARRET_PRODUCTION;

/* Commande du contacteur */
 switch
  | - DO_ARRET_PRODUCTION -> VISUEL_ARRET_PRODUCTION(mode="off", libelle="Solaire désactivée"), MSG_DISABLE;
  | -                     -> VISUEL_ARRET_PRODUCTION(mode="on",  libelle="Solaire activée"),    MSG_ENABLE;
                            
 - /INTENSITE(in_range) -> MSG_INTENSITE_NOTINRANGE;

/* Calcul de la production */
 - SHELLY_EDF:EM10_VOLTAGE * INTENSITE -> PRODUCTION;
 - TICK_WH -> CI_WH;
